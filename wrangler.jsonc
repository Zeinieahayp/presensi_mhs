
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "presensi-mhs",
  "main": "src/index.js",
  "compatibility_date": "2026-11-12",

  "assets": {
    "directory": "./main",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "presensi_mhs_db",
      "database_id": "662dc5ad-bf75-4c45-a1ea-17eebca29dc0"
    }
  ]
}
